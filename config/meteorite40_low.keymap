#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/custom_config.dtsi>
#include <dt-bindings/zmk/custom_config.h>

&mt { 
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <250>;
    quick-tap-ms = <200>; // change 200 to 150
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>; // change 200 to 150
    quick-tap-ms = <200>; // change 200 to 150
};

/ { 
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <20 21>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;
            layers = <0>;
        };

        rshift_gui {
            bindings = <&kp LG(LSHIFT)>;
            key-positions = <30 31>;
            layers = <0 3 4>;
        };

        backspace {
            bindings = <&kp BSPC>;
            key-positions = <8 9>;
            layers = <0 3>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <5 6>;
            layers = <0 3>;
        };

        n0_combo {
            bindings = <&kp N0>;
            key-positions = <32 33>;
            layers = <0>;
        };

        n1_combo {
            bindings = <&kp N1>;
            key-positions = <21 22>;
            layers = <0>;
        };

        n2_combo {
            bindings = <&kp N2>;
            key-positions = <22 23>;
            layers = <0>;
        };

        n3_combo {
            bindings = <&kp N3>;
            key-positions = <23 24>;
            layers = <0>;
        };

        n4_combo {
            bindings = <&kp N4>;
            key-positions = <11 12>;
            layers = <0>;
        };

        n5_combo {
            bindings = <&kp N5>;
            key-positions = <12 13>;
            layers = <0>;
        };

        n6_combo {
            bindings = <&kp N6>;
            key-positions = <13 14>;
            layers = <0>;
        };

        n7_combo {
            bindings = <&kp N7>;
            key-positions = <1 2>;
            layers = <0>;
        };

        n8_combo {
            bindings = <&kp N8>;
            key-positions = <2 3>;
            layers = <0>;
        };

        n9_combo {
            bindings = <&kp N9>;
            key-positions = <3 4>;
            layers = <0>;
        };

		bootloader_combo {
            bindings = <&bootloader>;
            key-positions = <18 24>;
            layers = <1 2>;
        };
		bluetooth_combo_1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <4 24>;
            layers = <1>;
        };

		bluetooth_combo_2 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <4 24>;
            layers = <2>;
        };


    };

    keymap {
        compatible = "zmk,keymap";
        layout = &LOW_PROFILE_DEFAULT;

        win_default_layer {
            display-name = "BASE";
            bindings = <
                &kp Q        &kp W       &kp E        &kp R        &kp T                                  &kp Y        &kp U      &kp I       &kp O    &kp P
                &kp A        &kp S       &kp D        &kp F        &kp G                                  &kp H        &kp J      &kp K       &kp L    &kp SEMI 
                &mt LSHIFT Z &kp X       &kp C        &kp V        &kp B        &kp BSPC     &kp DEL      &kp N        &kp M      &kp COMMA   &kp DOT  &mt LSHIFT SLASH
                                         &kp LCTRL    &mo 4        &lt 2 SPACE  &mkp MB1     &mkp MB2     &lt 1 ENTER  &mo 3      &kp LALT
            >;
        };

        layer_1 {
            display-name = "SYMBOLS";
            bindings = <
                &kp EXCL    &kp AT      &kp HASH     &kp DLLR      &kp PRCNT                           &kp CARET    &kp AMPS        &kp STAR      &kp LPAR      &kp RPAR
                &kp N1      &kp N2      &kp N3       &kp N4        &kp N5                              &kp GRAVE    &kp MINUS       &kp EQUAL     &kp LBKT      &kp RBKT
                &kp N6      &kp N7      &kp N8       &kp N9        &kp N0         &kp PIPE  &kp BSLH   &kp TILDE    &kp UNDERSCORE  &kp PLUS      &kp LBRC      &kp RBRC
                                        &LG(TILDE)   &kp LG(GRAVE) &kp LG(SPACE)  &mkp MB3  &mkp MB3   &mo 1        &none           &none
            >;
        };

        layer_2 {
            display-name = "ARROW";
            bindings = <
                &none   &kp HOME       &kp UP         &kp END        &none                             &kp DEL  &kp C_VOL_DN   &kp C_VOL_UP   &kp C_MUTE  &kp BSPC
                &none   &kp LEFT       &kp DOWN       &kp RIGHT      &none                             &none    &kp LSHIFT     &kp LGUI       &kp LALT    &kp LCTRL
                &none   &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5)) &none  &kp LG(LBKT) &kp LG(RBKT)  &none    &kp LG(MINUS)  &kp LG(EQUAL)  &none       &none
                                       &none          &none          &mo 2  &mkp MB3     &mkp MB3    &kp LG(SPACE)   &kp LS(LC(TAB))   &kp LC(TAB)
            >;
        };

        layer_3 {
            display-name = "RGUI";
            bindings = <
                &kp LG(Q)        &kp LG(W)       &kp LG(E)        &kp LG(R)        &kp LG(T)                                 &kp LG(Y)        &kp LG(U)       &kp LG(I)       &kp LG(O)    &kp LG(P)
                &kp LG(A)        &kp LG(S)       &kp LG(D)        &kp LG(F)        &kp LG(G)                                 &kp LG(H)        &kp LG(J)       &kp LG(K)       &kp LG(L)    &kp LG(SEMI) 
                &mt LSHIFT LG(Z) &kp LG(X)       &kp LG(C)        &kp LG(V)        &kp LG(B)       &none        &none        &kp LG(N)        &kp LG(M)       &kp LG(COMMA)   &kp LG(DOT)  &mt LSHIFT LG(SLASH)
                                                 &kp LG(LCTRL)    &kp LSHIFT       &kp SPACE       &none        &none        &kp ENTER        &mo 3           &kp LG(LALT)
            >;
        };

        layer_4 {
			display-name = "LGUI";
			bindings = <
                &kp LG(Q)        &kp LG(W)       &kp LG(E)        &kp LG(R)        &kp LG(T)                                 &kp LG(Y)        &kp LG(U)       &kp LG(I)       &kp LG(O)    &kp LG(P)
                &kp LG(A)        &kp LG(S)       &kp LG(D)        &kp LG(F)        &kp LG(G)                                 &kp LG(H)        &kp LG(J)       &kp LG(K)       &kp LG(L)    &kp LG(SEMI) 
                &mt LSHIFT LG(Z) &kp LG(X)       &kp LG(C)        &kp LG(V)        &kp LG(B)       &none        &none        &kp LG(N)        &kp LG(M)       &kp LG(COMMA)   &kp LG(DOT)  &mt LSHIFT LG(SLASH)
                                                 &kp LG(LCTRL)    &mo 4            &kp SPACE       &none        &none        &kp ENTER        &kp LSHIFT      &kp LG(LALT)
            >;
        };
    };
};
