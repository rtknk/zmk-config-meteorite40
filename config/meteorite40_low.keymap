#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/custom_config.dtsi>
#include <dt-bindings/zmk/custom_config.h>

&mt { 
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <250>;
    quick-tap-ms = <200>; // change 200 to 150
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>; // change 200 to 150
    quick-tap-ms = <200>; // change 200 to 150
};

/ { 
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;
            layers = <0>;
        };

        backspace {
            bindings = <&kp BSPC>;
            key-positions = <8 9>;
            layers = <0 3>;
        };

        delete {
            bindings = <&kp DEL>;
			key-positions = <5 6>;
            layers = <0 3>;
        };

		bluetooth_combo_1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <4 24>;
            layers = <1>;
        };

		bluetooth_combo_2 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <4 24>;
            layers = <2>;
        };
    };

	macros {
        // Alt + Left Click Macro
        alt_mb1: alt_mb1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>      // Altを押す
                , <&macro_press &mkp MB1>      // 左クリックを押す
                , <&macro_pause_for_release>   // キーを離すまで待機
                , <&macro_release &mkp MB1>    // 左クリックを離す
                , <&macro_release &kp LALT>;   // Altを離す
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layout = &LOW_PROFILE_DEFAULT;

        win_default_layer {
            display-name = "BASE";
            bindings = <
                &kp Q        &kp W       &kp E        &kp R        &kp T                              &kp Y        &kp U      &kp I       &kp O    &kp P
                &kp A        &kp S       &kp D        &kp F        &kp G                              &kp H        &kp J      &kp K       &kp L    &kp SEMI 
                &mt LSHIFT Z &kp X       &kp C        &kp V        &kp B        &alt_mb1   &mkp MB3   &kp N        &kp M      &kp COMMA   &kp DOT  &mt LSHIFT SLASH
									     &kp LCTRL    &kp LGUI     &lt 2 SPACE  &mkp MB1   &mkp MB2   &lt 1 ENTER  &kp BSPC   &kp LALT
            >;
        };

        layer_1 {
            display-name = "SYMBOLS";
            bindings = <
                &kp EXCL    &kp AT      &kp HASH     &kp DLLR      &kp PRCNT                           &kp CARET    &kp AMPS        &kp STAR      &kp LPAR      &kp RPAR
                &kp N1      &kp N2      &kp N3       &kp N4        &kp N5                              &kp TILDE    &kp MINUS       &kp EQUAL     &kp LBKT      &kp RBKT
                &kp N6      &kp N7      &kp N8       &kp N9        &kp N0      &kp PIPE    &kp BSLH    &kp GRAVE    &kp UNDERSCORE  &kp PLUS      &kp LBRC      &kp RBRC
									    &none        &none         &kp SPACE   &trans      &trans      &mo 1        &none           &none
            >;
        };

        layer_2 {
            display-name = "ARROW";
            bindings = <
                &kp ESC       &kp HOME       &kp UP         &kp END        &none                         &none           &kp C_VOL_DN    &kp C_VOL_UP   &kp C_MUTE  &none
                &kp TAB       &kp LEFT       &kp DOWN       &kp RIGHT      &none                         &kp LS(LALT)    &kp LSHIFT      &kp LGUI       &kp LALT    &kp LCTRL
                &kp CAPSLOCK  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5)) &none    &mkp MB3  &mkp MB3   &none           &kp LG(MINUS)   &kp LG(EQUAL)  &none       &none
								     	  &none	  		 &none  		&mo 2       &trans    &trans	 &kp LG(SPACE)   &none           &none
            >;
        };
    };
};

// &ccfg C_CPI_DN  &ccfg C_CPI_UP
// &ccfg C_ROT_DN  &ccfg C_ROT_UP
